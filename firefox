  python3 - << 'PY'
import os, tarfile, lzma, bz2, gzip, io
src="/tmp/firefox.tar.xz"
dst="/home/runner/firefox-dist"
os.makedirs(dst, exist_ok=True)
with open(src,"rb") as f:
    mag=f.read(8)
print("magic", mag[:6])
if mag.startswith(b"\xfd7zXZ"):
    with lzma.open(src) as z, tarfile.open(fileobj=z) as t:
        t.extractall(dst)
elif mag.startswith(b"BZh"):
    with tarfile.open(src, "r:bz2") as t:
        t.extractall(dst)
elif mag.startswith(b"\x1f\x8b"):
    with tarfile.open(src, "r:gz") as t:
        t.extractall(dst)
else:
    with tarfile.open(src, "r:*") as t:
        t.extractall(dst)
print("extract ok")
PY
